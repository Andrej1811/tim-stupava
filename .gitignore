# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*
# Cache Enabler writes this drop-in on activation and removes it on deactivation
web/app/advanced-cache.php
# webp-converter-for-media output tree (mirrors uploads/)
web/app/uploads-webpc/
# server-specific, managed by hand on the host (basic auth etc.)
web/app/.htaccess
# Downloaded translations (restored by WP on demand)
web/app/languages/

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# OS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Local tooling caches
.rtk/
.codegraph/
