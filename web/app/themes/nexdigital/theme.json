{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "768px",
            "wideSize": "1240px"
        },
        "color": {
            "custom": true,
            "customGradient": true,
            "palette": [
                { "slug": "brand", "name": "Petrol", "color": "#096165" },
                { "slug": "brand-dark", "name": "Petrol Dark", "color": "#044c50" },
                { "slug": "brand-deep", "name": "Petrol Deep", "color": "#001d1f" },
                { "slug": "accent", "name": "Magenta", "color": "#e31754" },
                { "slug": "teal", "name": "Teal", "color": "#13e4da" },
                { "slug": "ink", "name": "Ink", "color": "#061920" },
                { "slug": "muted", "name": "Muted", "color": "#465f68" },
                { "slug": "border", "name": "Border", "color": "#dce7ea" },
                { "slug": "surface", "name": "Surface (cool)", "color": "#f6f9fa" },
                { "slug": "sand", "name": "Surface (warm)", "color": "#f9f3ea" },
                { "slug": "sand-deep", "name": "Surface (warm, deep)", "color": "#e1d5c6" },
                { "slug": "white", "name": "White", "color": "#ffffff" }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "sans",
                    "name": "Sans",
                    "fontFamily": "\"Montserrat Variable\", Montserrat, ui-sans-serif, system-ui, sans-serif"
                }
            ]
        },
        "spacing": {
            "units": ["px", "em", "rem", "vw", "%"]
        }
    },
    "styles": {
        "color": {
            "background": "#ffffff",
            "text": "#061920"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)"
        }
    },
    "_comment": "No styles.elements.link here on purpose. WordPress prints theme.json styles UNLAYERED, and unlayered CSS outranks every cascade layer regardless of specificity. Tailwind v4 puts all utilities in @layer, so an elements.link rule silently overrides text-white, .site-nav a and every other link utility. WP 7.0 exposes no filter on wp_get_global_stylesheet(), so it cannot be wrapped in a layer — the fix is to not emit the rule. Link colour belongs in Tailwind. Keep any future styles.* additions element-free for the same reason."
}
