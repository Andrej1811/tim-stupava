# Skopíruj na .env a doplň vlastné hodnoty:  cp .env.example .env
# Soli vygeneruj na https://roots.io/salts.html alebo cez `wp config shuffle-salts`.

DB_NAME=tim_stupava
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PREFIX=ts_

# Voliteľne namiesto DB_* premenných vyššie:
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/tim_stupava

WP_ENV=development
WP_HOME=http://localhost:8000
WP_SITEURL=${WP_HOME}/wp

AUTH_KEY=''
SECURE_AUTH_KEY=''
LOGGED_IN_KEY=''
NONCE_KEY=''
AUTH_SALT=''
SECURE_AUTH_SALT=''
LOGGED_IN_SALT=''
NONCE_SALT=''
